{
	"name": "pagbank-for-woocommerce",
	"version": "2.0.4",
	"author": "Elias Júnior <me@eliasjr.dev>",
	"license": "GPL-2.0-only",
	"type": "module",
	"packageManager": "pnpm@12.14.0",
	"scripts": {
		"setup": "./scripts/initial-setup.sh",
		"composer": "./scripts/composer.sh",
		"dev": "npx tsx scripts/dev-ui.ts",
		"prebuild": "pnpm composer install --no-dev --optimize-autoloader",
		"build": "tsc && npx tsx scripts/build-ui.ts",
		"postbuild": "pnpm composer install",
		"preexport": "pnpm composer install --no-dev --optimize-autoloader",
		"export": "tsc && npx tsx scripts/build-ui.ts && npx tsx scripts/export.ts && npx tsx scripts/verify-export.ts",
		"postexport": "pnpm composer install",
		"lint": "concurrently \"pnpm lint:core\" \"pnpm lint:ui\"",
		"lint:core": "./scripts/phpcs.sh",
		"lint:fix:core": "./scripts/phpcbf.sh",
		"lint:ui": "biome check src scripts",
		"lint:fix:ui": "biome check --write src scripts",
		"analyse": "./scripts/phpstan.sh",
		"test": "./scripts/phpunit.sh",
		"bump": "npx tsx scripts/bump-version.ts",
		"check:version": "npx tsx scripts/check-version.ts",
		"todos": "leasot 'src/**/*.{php,ts,js}'",
		"make:pot": "./scripts/make-pot.sh",
		"wp": "docker compose exec -u www-data wordpress wp",
		"pagbank:save-credentials": "npx tsx scripts/pagbank-credentials.ts",
		"worktree:env": "npx tsx scripts/worktree-env.ts",
		"tunnel:url": "./scripts/tunnel-url.sh"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@types/escape-html": "^1.0.4",
		"@types/jquery": "^3.5.33",
		"@types/jquery.blockui": "^0.0.33",
		"@types/node": "^24.19.2",
		"@types/react": "^18.3.27",
		"@types/react-dom": "^18.3.7",
		"concurrently": "^10.0.6",
		"husky": "^9.1.7",
		"jszip": "^3.10.2",
		"leasot": "^14.4.0",
		"sass": "^1.105.2",
		"terser": "^5.51.2",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vite": "^8.3.4"
	},
	"dependencies": {
		"@hookform/resolvers": "^6.0.0",
		"@tanstack/react-query": "^5.104.5",
		"@wordpress/api-fetch": "^7.57.0",
		"@wordpress/components": "^30.9.0",
		"@wordpress/data": "^10.57.0",
		"@wordpress/element": "^6.36.0",
		"@wordpress/html-entities": "^4.57.0",
		"@wordpress/i18n": "^6.30.0",
		"@wordpress/notices": "^5.57.0",
		"autonumeric": "^4.10.10",
		"axios": "^1.13.2",
		"card-validator": "^10.0.4",
		"date-fns": "^4.4.0",
		"escape-html": "^1.0.3",
		"jquery": "^3.7.1",
		"jsbarcode": "^3.12.3",
		"libphonenumber-js": "^1.13.15",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-hook-form": "^7.90.0",
		"zod": "^4.6.7"
	}
}
